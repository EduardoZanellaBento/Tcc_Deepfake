# Ambientes Python
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Dados pesados - NAO subir para o git (sao muitos GB)
data/raw/
data/processed/*
!data/processed/split.csv
!data/processed/split_181k.csv
!data/processed/subamostra_30k.csv
# Subamostras alternativas da análise de estabilidade (R6.2): só listas de IDs,
# ~760 KB cada. Versionadas para que os MD5 gravados em
# estabilidade_subamostra.json sejam verificáveis sem re-gerar nada.
!data/processed/subamostras_estabilidade/
!data/processed/subamostras_estabilidade/*.csv
# Split interno da CNN (B4.3): 27.000 treino_interno / 3.000 early_stopping.
# Versionado pelo mesmo motivo do split.csv — sem o arquivo em disco, "a CNN
# parou na epoca 14" deixa de ser uma afirmacao verificavel.
!data/processed/split_interno_cnn.csv
data/features/*.csv
# meta do piloto e descartavel (regenerado a cada verificar_mascaramento);
# o features.meta.json OFICIAL (assinatura da definicao congelada) e versionado
data/features/features_piloto_mascarado.meta.json
# Espectrogramas da CNN (Bloco 4): ~9,6 GB em float32 para os 74.453 tensores
# necessarios. Regra acrescentada em 04/09/2026, ANTES da geracao do primeiro
# arquivo - ver "Armadilha do .gitignore" em
# results/metricas/DECISOES_PENDENTES_CNN.md. Sem ela, um `git add .` distraido
# tentaria versionar o lote inteiro. So o .meta.json (assinatura da definicao,
# alguns KB) e versionado, pelo mesmo motivo do features.meta.json.
data/espectrogramas/*
!data/espectrogramas/espectrogramas.meta.json
# Estatisticas de normalizacao da CNN (B4.3): 128 medias + 128 desvios, alguns
# KB. Exigencia explicita do orientador — "e o que torna a inferencia
# reproduzivel". Sem ele versionado, os tensores crus do lote nao bastam para
# reconstruir a entrada que a rede viu.
!data/espectrogramas/normalizacao_cnn.json
# Estatisticas do REFIT (B4.6): recomputadas sobre os 30.000 completos, porque a
# P3 manda usar "o treino efetivamente disponivel naquele estagio" e no refit ele
# e o conjunto inteiro. Os DOIS artefatos coexistem de proposito — o dos 27k
# documenta a fase de early stopping (sem ele a melhor epoca deixa de ser
# reproduzivel) e o dos 30k documenta a CNN final, que e a que o B4.7 e o B5.1
# usam na inferencia. O campo `estagio` dentro de cada um impede a troca.
!data/espectrogramas/normalizacao_cnn_30k.json

# Modelos treinados (regeneraveis pelo pipeline)
models/*
!models/.gitkeep

# Sistema
.DS_Store
Thumbs.db
